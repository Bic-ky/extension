{
  "manifest_version": 3,
  "name": "Fleet User Fetcher",
  "version": "1.0",
  "description": "Fetches a list of users for a specific park_id.",
  "action": {
    "default_title": "Open Exporter Sidebar"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "permissions": [
    "sidePanel",
    "cookies",
    "storage",
    "tabs", 
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://fleet.yango.com/*",
    "http://127.0.0.1:8000/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://fleet.yango.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["*://fleet.yango.com/*"]
    }
  ]
}